# --- Vercel / Next.js environment ---
# Set these in Vercel project settings (Settings -> Environment Variables).
# They are baked into the client bundle at build time, so NEXT_PUBLIC_* must be
# present DURING the build (both Preview and Production).

# Deployed veridoc contract on GenLayer Studionet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x59b178Ea985071B0b0CBa11dBb2dC2b722B2946a

# Studionet JSON-RPC endpoint (used server-side by /api/rpc proxy)
NEXT_PUBLIC_RPC_URL=https://studio.genlayer.com/api

# Explorer link used in the UI
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com

# (Optional) Admin wallet that can call withdraw_fee — shown as 👑 Admin badge.
# NEXT_PUBLIC_ADMIN_ADDRESS=0xc2d388EEBFc9CBEA6fE34A94505dEbE24daE9300
